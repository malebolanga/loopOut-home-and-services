# Required in production. Set the real values in Render; never commit them.
MONGO=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=<generate-a-long-random-secret>
CLIENT_URL=https://your-domain.example
APP_URL=https://your-domain.example
BACKEND_URL=https://api.your-domain.example
EMAIL_USER=notifications@your-domain.example
EMAIL_PASS=<smtp-password-or-app-password>

# Optional services
EMAIL_HOST=smtp.your-provider.example
EMAIL_PORT=587
EMAIL_SECURE=false
OPENAI_API_KEY=
# Firebase Admin service account JSON; keep this secret in the backend environment.
# Enables server-side authentication and sending Android FCM push notifications.
FIREBASE_SERVICE_ACCOUNT_JSON=
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=

# Browser origins allowed to call the API with credentials, comma-separated (optional).
# CLIENT_URL, APP_URL, RENDER_EXTERNAL_URL, the Firebase Hosting domains and localhost are already allowed.
CORS_ALLOWED_ORIGINS=

# AI features (optional model overrides)
OPENAI_MODEL=
OPENAI_WEB_SEARCH_MODEL=

# Optional SMS/WhatsApp settings
TWILIO_WHATSAPP_COUNTRY_CODE=27

# Push notifications: path to a service-account file instead of FIREBASE_SERVICE_ACCOUNT_JSON (optional)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=central-cinema-218106

# Rate limits per IP (optional; defaults shown)
APP_RATE_LIMIT=1500
AI_RATE_LIMIT=40
