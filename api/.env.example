# Required in production. Set the real values in Railway; never commit them.
MONGO=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=<generate-a-long-random-secret>
CLIENT_URL=https://your-domain.example
APP_URL=https://your-domain.example
BACKEND_URL=https://api.your-domain.example
EMAIL_USER=notifications@your-domain.example
EMAIL_PASS=<smtp-password-or-app-password>

# Optional services
EMAIL_HOST=smtp.your-provider.example
EMAIL_PORT=587
EMAIL_SECURE=false
OPENAI_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
# Optional WhatsApp order-ready alerts. Requires an approved Twilio WhatsApp sender
# and approved Content Template such as: "Your order {{1}} from {{2}} is ready for collection."
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_READY_CONTENT_SID=
TWILIO_WHATSAPP_COUNTRY_CODE=27
