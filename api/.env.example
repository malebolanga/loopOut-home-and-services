# Required in production. Set the real values in Render; never commit them.
MONGO=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=<generate-a-long-random-secret>
CLIENT_URL=https://your-domain.example
APP_URL=https://your-domain.example
BACKEND_URL=https://api.your-domain.example
EMAIL_USER=notifications@your-domain.example
EMAIL_PASS=<smtp-password-or-app-password>

# Optional services
EMAIL_HOST=smtp.your-provider.example
EMAIL_PORT=587
EMAIL_SECURE=false
OPENAI_API_KEY=
# Firebase Admin service account JSON; keep this secret in the backend environment.
# Enables server-side authentication and sending Android FCM push notifications.
FIREBASE_SERVICE_ACCOUNT_JSON=
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
