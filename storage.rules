rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // The app uses its own JWT accounts, not Firebase Authentication. Direct
    // browser uploads would bypass authorization, so they are prohibited.
    // Upload media through an authenticated backend endpoint instead.
    match /{path=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
